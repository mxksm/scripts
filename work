#!/usr/bin/env python3
import os
import re
import argparse
import shutil
import subprocess
from pathlib import Path
from typing import List, Optional

class AcademicWorkflow:
    def __init__(self):
        self.config = {
            'semester_path': Path.home() / "Documents/university/3_year/2_semester",
            'resume_path': Path.home() / "Documents/resume",
            'templates': Path.home() / ".templates",
            'editor': "nvim",
            'hw_format': "hw{:02d}"
        }
        
        self.file_config = {
            'latex': {'default': 'main.tex', 'template': 'template.tex'},
            'typst': {'default': 'main.typ', 'template': 'template.typ'}
        }

    def run(self):
        args = self.parse_args()
        self.handle_commands(args)

    def parse_args(self):
        parser = argparse.ArgumentParser(description="Academic document workflow manager")
        
        # Core functionality
        parser.add_argument('course', nargs='?', help="Course name pattern")
        parser.add_argument('hw_number', nargs='?', type=int, help="Homework number")
        
        # Operations
        parser.add_argument('-n', '--new', metavar='COURSE', help="Create new homework for course")
        parser.add_argument('-k', '--kit', metavar='FOLDER', help="Create template folder in CWD")
        parser.add_argument('-d', '--directory', help="Change directory only")
        parser.add_argument('-o', '--open', help="Change directory and open files")
        
        # File handling
        parser.add_argument('-f', '--file', help="Specify exact file to open")
        parser.add_argument('-t', '--typst', action='store_true', help="Force Typst workflow")
        parser.add_argument('-l', '--latex', action='store_true', help="Force LaTeX workflow")
        
        # Path resolution
        parser.add_argument('-s', '--semester', action='store_true', 
                          help="Use semester path as root directory")
        parser.add_argument('-r', '--resume', action='store_true',
                          help="Work with resume documents")

        return parser.parse_args()

    def handle_commands(self, args):
        try:
            if args.resume:
                self.handle_resume(args)
            elif args.new:
                self.create_course_hw(args.new, args)
            elif args.kit:
                self.create_template_kit(args.kit, args)
            elif args.directory:
                self.change_directory(args.directory, args)
            elif args.open:
                self.open_directory(args.open, args)
            else:
                self.handle_default_operation(args)
        except Exception as e:
            print(f"Error: {str(e)}")
            exit(1)

    def handle_resume(self, args):
        target = self.config['resume_path']
        if args.file:
            self.open_editor(target / args.file)
        else:
            self.open_directory(target, args)

    def handle_default_operation(self, args):
        if args.course:
            course_path = self.find_course(args.course)
            hw_path = self.resolve_hw_path(course_path, args.hw_number)
            self.open_hw_folder(hw_path, args)
        else:
            self.open_current_directory(args)

    def resolve_base_path(self, args) -> Path:
        if args.semester:
            return self.config['semester_path']
        return Path.cwd()

    def find_course(self, pattern: str) -> Path:
        courses = [d for d in self.config['semester_path'].iterdir() if d.is_dir()]
        matches = [c for c in courses if pattern.lower() in c.name.lower()]
        
        if not matches:
            raise FileNotFoundError(f"No course matching '{pattern}'")
        if len(matches) > 1:
            return self.prompt_choice(matches)
        return matches[0]

    def resolve_hw_path(self, course_path: Path, hw_number: Optional[int]) -> Path:
        hw_dir = course_path / "hw"
        if not hw_dir.exists():
            hw_dir.mkdir()
        
        if hw_number:
            return hw_dir / self.config['hw_format'].format(hw_number)
        
        existing_hw = sorted(hw_dir.glob("hw*"), key=self.hw_sort_key)
        if not existing_hw:
            raise FileNotFoundError("No homework folders found")
        return existing_hw[-1]

    def hw_sort_key(self, path: Path) -> int:
        match = re.search(r'hw(\d+)', path.name)
        return int(match.group(1)) if match else 0

    def create_course_hw(self, course_pattern: str, args):
        course_path = self.find_course(course_pattern)
        hw_dir = course_path / "hw"
        
        latest_hw = max((self.hw_sort_key(p) for p in hw_dir.glob("hw*")), default=0)
        new_hw_num = latest_hw + 1
        new_hw_path = hw_dir / self.config['hw_format'].format(new_hw_num)
        
        template_type = self.detect_template_type(course_path) or self.get_template_type(args)
        self.create_template_files(new_hw_path, template_type)
        self.update_hw_number(new_hw_path, new_hw_num, template_type)
        
        print(f"Created new homework: {new_hw_path}")
        
        # Change to new homework directory
        os.chdir(new_hw_path)

        # Open the newly created homework
        default_file = new_hw_path / self.file_config[template_type]['default']
        self.open_editor(default_file)

    def update_hw_number(self, hw_path: Path, hw_num: int, template_type: str):
        """Updates homework number in the template template file"""
        template_file = hw_path / self.file_config[template_type]['template']
        
        if not template_file.exists():
            return
        
        # Get plain number without leading zeros
        display_num = str(hw_num)
        
        with open(template_file, 'r') as f:
            content = f.read()
        
        # Pattern matching for both LaTeX and Typst
        if template_type == 'typst':
            pattern = r'(#let title\s*=\s*"[^"]*Homework )\d+(")'
            replacement = fr'\g<1>{display_num}\2'
        else:  # latex
            pattern = r'(\\title\{[^}]*Homework )\d+(\})'
            replacement = fr'\g<1>{display_num}\2'
        
        new_content = re.sub(pattern, replacement, content)
        
        if new_content == content:
            print(f"Warning: Could not find homework number in {template_file.name}")
            return
        
        with open(template_file, 'w') as f:
            f.write(new_content)

    def create_template_kit(self, folder_name: str, args):
        target = Path.cwd() / folder_name
        target.mkdir(exist_ok=True)
        
        template_type = self.get_template_type(args)
        self.create_template_files(target, template_type)
        print(f"Created template kit: {target}")

    def detect_template_type(self, course_path: Path) -> Optional[str]:
        hw_dir = course_path / "hw"
        for p in reversed(sorted(hw_dir.glob("hw*"), key=self.hw_sort_key)):
            if (p / "main.typ").exists():
                return 'typst'
            if (p / "main.tex").exists():
                return 'latex'
        return None

    def get_template_type(self, args) -> str:
        if args.typst:
            return 'typst'
        if args.latex:
            return 'latex'
        return 'typst'  # Default

    def create_template_files(self, target: Path, template_type: str):
        target.mkdir(exist_ok=True, parents=True)
        
        for ftype in ['default', 'template']:
            template = self.file_config[template_type][ftype]
            src = self.config['templates'] / template
            dest = target / template
            
            if not dest.exists():
                shutil.copy(src, dest)

    def open_directory(self, path: str, args):
        base = self.config['semester_path'] if args.semester else Path.cwd()
        target = base / path
        os.chdir(target)
        
        if args.file:
            self.open_editor(target / args.file)
        else:
            self.open_hw_folder(target, args)

    def change_directory(self, path: str, args):
        base = self.config['semester_path'] if args.semester else Path.cwd()
        os.chdir(base / path)

    def open_hw_folder(self, hw_path: Path, args):
        os.chdir(hw_path)
        file_to_open = self.resolve_file(hw_path, args)
        self.open_editor(file_to_open)

    def resolve_file(self, path: Path, args) -> Path:
        if args.file:
            return path / args.file
        
        # Check forced template type first
        if args.typst or args.latex:
            template_type = 'typst' if args.typst else 'latex'
            for f in [self.file_config[template_type]['default'],
                      self.file_config[template_type]['template']]:
                candidate = path / f
                if candidate.exists():
                    return candidate
        
        # Auto-detect
        for ext in ['typ', 'tex']:
            for fname in ['main', 'content', 'template']:
                candidate = path / f"{fname}.{ext}"
                if candidate.exists():
                    return candidate
        
        # template to any existing file
        for ext in ['typ', 'tex']:
            files = list(path.glob(f"*.{ext}"))
            if files:
                return files[0]
        
        raise FileNotFoundError(f"No valid files found in {path}")

    def open_editor(self, file_path: Path):
        """Opens file in Neovim with exact command structure from original script"""
        editor_cmd = [self.config['editor'], str(file_path)]
        file_stem = file_path.stem  # Gets filename without extension

        if file_path.suffix == '.typ':
            editor_cmd += [
                '-c', f'lua require("nvterm.terminal").send("typst watch {file_path.name}", "horizontal")',
                '-c', f'lua vim.fn.jobstart({{"zsh", "-c", "source ~/.zshrc && pdf {file_stem}"}}, {{detach = true}})'
            ]
        elif file_path.suffix == '.tex':
            editor_cmd += [
                '-c', 'set filetype=tex',
                '-c', 'VimtexCompile'
            ]

        subprocess.run(editor_cmd)

    def get_compile_command(self, file_path: Path) -> List[str]:
        if file_path.suffix == '.typ':
            return ["typst", "watch", file_path.name]
        return ["latexmk", "-pdf", "-interaction=nonstopmode", file_path.name]

    def prompt_choice(self, options: List[Path]) -> Path:
        print("Multiple matches found:")
        for i, path in enumerate(options, 1):
            print(f"{i}: {path.name}")
        
        while True:
            choice = input("Enter number: ")
            if choice.isdigit() and 0 < int(choice) <= len(options):
                return options[int(choice)-1]
            print("Invalid choice")

if __name__ == "__main__":
    workflow = AcademicWorkflow()
    workflow.run()
