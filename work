#!/usr/bin/env python3
import os
import argparse
import subprocess
from pathlib import Path
from typing import Optional, Dict

# ==========================================
# 1. THE REGISTRY (Configuration)
# ==========================================
# This makes adding new templates in the future completely frictionless.
# To add "exams", just add an entry here. No logic changes needed.

WORKFLOWS = {
    'hw': {
        'folder_name': 'hw',
        'prefix': 'hw',
        'template': '@local/my-hw',
        'auto_increment': True,
        'default_title': 'Homework'
    },
    'pso': {
        'folder_name': 'pso',
        'prefix': 'pso',
        'template': '@local/my-pso',
        'auto_increment': True,
        'default_title': 'Problem Session'
    },
    'notes': {
        'folder_name': 'notes',
        'prefix': '',
        'template': '@local/my-lec-notes',
        'auto_increment': False,
        'default_title': 'Lecture Notes'
    }
}

class AcademicEnvironment:
    def __init__(self):
        self.semester_path = Path.home() / "Documents/university/4_year/2_semester"
        #self.semester_path = Path.home() / "Documents/university/5_year/1_semester"
        self.editor = "nvim"

    def find_course(self, pattern: str) -> Path:
        """Find a course folder by pattern matching"""
        if not self.semester_path.exists():
            raise FileNotFoundError(f"Semester path not found: {self.semester_path}")
            
        courses = [d for d in self.semester_path.iterdir() if d.is_dir()]
        matches = [c for c in courses if pattern.lower() in c.name.lower()]
        
        if not matches:
            raise FileNotFoundError(f"No course matching '{pattern}'")
        if len(matches) > 1:
            # For now, just return the first match to keep it simple, 
            # we can add the interactive prompt back later if needed.
            print(f"Multiple matches found, using: {matches[0].name}")
        return matches[0]

# ==========================================
# 2. THE SCAFFOLDER (State & File Creation)
# ==========================================
class Scaffolder(AcademicEnvironment):
    def generate_meta_file(self, target_dir: Path, course_name: str, config: Dict, number: int = None):
        """Creates a meta.typ file so Typst templates know their context without regex"""
        meta_path = target_dir / "meta.typ"
        
        # Format course name (e.g., removing TA-)
        formatted_course = course_name[3:].upper() if course_name.lower().startswith('ta-') else course_name.upper()
        
        with open(meta_path, 'w') as f:
            f.write(f'#let course = "{formatted_course}"\n')
            if number is not None:
                # We use hw_num here since your template expects it!
                f.write(f'#let hw_num = {number}\n')

    def init_workflow(self, target_name: str, workflow_type: str, is_local: bool = False):
        config = WORKFLOWS[workflow_type]
        
        # ==========================================
        # LOCAL MODE (Standalone Folder in CWD)
        # ==========================================
        if is_local:
            target_dir = Path.cwd() / target_name
            course_name = target_name  # Use the folder name as the course name for meta.typ
            current_num = None         # No auto-incrementing for standalone folders
            
            if target_dir.exists() and any(target_dir.iterdir()):
                print(f"Directory already exists and is not empty: {target_dir}")
                return target_dir

        # ==========================================
        # COURSE MODE (University Semester Logic)
        # ==========================================
        else:
            course_path = self.find_course(target_name)
            workflow_dir = course_path / config['folder_name']
            course_name = course_path.name

            target_dir = workflow_dir
            current_num = None

            if config['auto_increment']:
                workflow_dir.mkdir(exist_ok=True)
                existing = [d for d in workflow_dir.iterdir() if d.is_dir() and d.name.startswith(config['prefix'])]
                
                latest = 0
                for d in existing:
                    try:
                        num = int(d.name.replace(config['prefix'], ''))
                        latest = max(latest, num)
                    except ValueError:
                        continue
                        
                current_num = latest + 1
                target_dir = workflow_dir / f"{config['prefix']}{current_num:02d}"

            if target_dir.exists() and any(target_dir.iterdir()):
                print(f"Directory already exists and is not empty: {target_dir}")
                return target_dir

        # ==========================================
        # EXECUTE TYPST INIT
        # ==========================================
        print(f"Initializing {workflow_type} in {target_dir}...")
        
        try:
            subprocess.run(["typst", "init", config['template'], str(target_dir)], check=True)
        except subprocess.CalledProcessError:
            print(f"Error: Could not initialize Typst template '{config['template']}'. Is it installed?")
            return None

        # Generate the Meta file for state injection
        self.generate_meta_file(target_dir, course_name, config, current_num)
        print(f"Created successfully: {target_dir}")
        
        return target_dir

# ==========================================
# 3. THE OPENER (Execution & Environment)
# ==========================================
class Opener(AcademicEnvironment):
    def launch(self, target_path: Path, new_window: bool = False):
        # 1. Convert to absolute path immediately to avoid chdir bugs
        target_path = target_path.resolve()

        if not target_path.exists():
            raise FileNotFoundError(f"Path does not exist: {target_path}")

        file_to_open = target_path

        # 2. Smart directory opening logic
        if target_path.is_dir():
            candidates = ["main.typ", "main.tex", "README.md"]
            for candidate in candidates:
                if (target_path / candidate).exists():
                    file_to_open = target_path / candidate
                    break
            else:
                print(f"No obvious main file found in {target_path.name}. Opening directory root.")

        # 3. Change directory safely
        work_dir = target_path if target_path.is_dir() else target_path.parent
        os.chdir(work_dir)

        print(f"Opening: {file_to_open.name}")
        
        # Build exact Neovim command using the bulletproof absolute path
        editor_cmd = [self.editor, str(file_to_open)]
        
        if file_to_open.suffix == '.typ':
            sioyek_flag = "new" if new_window else ""
            file_stem = file_to_open.stem
            editor_cmd += [
                '-c', f'lua vim.fn.jobstart({{"zsh", "-c", "source ~/.zshrc && pdf {sioyek_flag} {file_stem}"}}, {{detach = true}})'
            ]
        elif file_to_open.suffix == '.tex':
            editor_cmd += [
                '-c', 'set filetype=tex',
                '-c', 'VimtexCompile'
            ]

        subprocess.run(editor_cmd)

# ==========================================
# CLI ENTRY POINT
# ==========================================
def main():
    # Dynamically generate the help text for workflow types
    type_desc = ", ".join([f"'{k}' ({v['default_title']})" for k, v in WORKFLOWS.items()])
    type_help = f"Specify the workflow type: {type_desc}. (Default: 'hw')"

    parser = argparse.ArgumentParser(
        description="Academic Document Workflow Manager",
        epilog="Example: 'work init parallel' -> Creates hw01 in the parallel course folder."
    )
    subparsers = parser.add_subparsers(dest="command", required=True, title="Available commands")

    # Init Command
    init_parser = subparsers.add_parser(
        'init', 
        help="Initialize a new document/folder (auto-increments numbers)",
        description="Creates a new folder based on your templates and sets up the meta.typ file."
    )
    # We renamed 'course' to 'target' here since it can now be a local folder name
    init_parser.add_argument('target', help="Course name pattern (e.g., '525') OR local folder name")
    init_parser.add_argument('-t', '--type', choices=WORKFLOWS.keys(), default='hw', help=type_help)
    init_parser.add_argument('-l', '--local', action='store_true', help="Create a standalone folder in the current directory")

    # Open Command
    open_parser = subparsers.add_parser(
        'open', 
        help="Open an existing document/folder and launch environment",
        description="Opens a file in Neovim and launches Sioyek + background compiler."
    )
    open_parser.add_argument('target', help="Course pattern (e.g., 'parallel') OR direct file path (e.g., '.')")
    # Add this line right here:
    open_parser.add_argument('num', nargs='?', type=int, help="Specific assignment number to open (e.g., 3 for hw03)")
    
    open_parser.add_argument('-t', '--type', choices=WORKFLOWS.keys(), default='hw', 
                             help="Workflow type to open if using a course pattern. Ignored for direct paths.")
    open_parser.add_argument('-wd', '--window', action='store_true', 
                             help="Open Sioyek PDF viewer in a new, separate window")

    args = parser.parse_args()

    try:
        if args.command == 'init':
            scaffolder = Scaffolder()
            # Pass args.local so the scaffolder knows which mode to use
            target_dir = scaffolder.init_workflow(args.target, args.type, args.local)
            if target_dir:
                Opener().launch(target_dir)

        elif args.command == 'open':
            opener = Opener()
            direct_path = Path(args.target)
            
            if direct_path.exists():
                file_to_open = direct_path
                if direct_path.is_dir():
                    for candidate in ["main.typ", "main.tex", "README.md"]:
                        if (direct_path / candidate).exists():
                            file_to_open = direct_path / candidate
                            break
                opener.launch(file_to_open, args.window)
            else:
                env = AcademicEnvironment()
                course_path = env.find_course(args.target)
                config = WORKFLOWS[args.type]
                workflow_dir = course_path / config['folder_name']
                
                if config['auto_increment']:
                    # CHECK FOR SPECIFIC NUMBER HERE
                    if args.num is not None:
                        # Auto-pads the number with a leading zero (e.g., 3 -> 03)
                        target = workflow_dir / f"{config['prefix']}{args.num:02d}"
                    else:
                        existing = sorted(workflow_dir.glob(f"{config['prefix']}*"))
                        if not existing:
                            raise FileNotFoundError(f"No {args.type} folders found in {course_path.name}")
                        target = existing[-1]
                else:
                    target = workflow_dir
                    
                opener.launch(target, args.window)

    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    main()
